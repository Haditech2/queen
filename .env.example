# MindBridge Environment Variables Example
# Copy this file to .env and fill in your own values. Never commit .env.
SECRET_KEY=mindbridge-secure-django-secret-key-change-in-production-2026-ng
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,[::1],testserver
# Comma-separated origins allowed to POST (needed for custom domains in production)
# CSRF_TRUSTED_ORIGINS=https://your-domain.com

# Database: SQLite is enabled by default for zero-setup local running on any PC
DATABASE_URL=sqlite:///mindbridge.sqlite3
# For production PostgreSQL: postgres://user:password@localhost:5432/mindbridge_db

# AI Provider Configuration (Google Gemini, NVIDIA, DeepSeek, Kimi, GLM, OpenAI)
# -------------------------------------------------------------
# Option 1: Google Gemini (Direct Native API & OpenAI-compatible)
AI_PROVIDER=gemini
AI_MODEL=gemini-3.6-flash
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_API_KEY=your-gemini-api-key
GEMINI_API_KEY=your-gemini-api-key

# Option 2: NVIDIA NIM API
# AI_PROVIDER=nvidia
# AI_MODEL=deepseek-ai/deepseek-v4.1-flash
# AI_BASE_URL=https://integrate.api.nvidia.com/v1
# AI_API_KEY=nvapi-...

# Option 3: DeepSeek
# AI_PROVIDER=deepseek
# AI_MODEL=deepseek-chat
# AI_BASE_URL=https://api.deepseek.com/v1
# AI_API_KEY=sk-...

# Option 4: OpenAI
# AI_PROVIDER=openai
# AI_MODEL=gpt-4o-mini
# AI_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=sk-...

TIME_ZONE=Africa/Lagos
LANGUAGE_CODE=en-us

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.your-email-provider.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=support@mindbridge.africa
EMAIL_HOST_PASSWORD=your-email-password
DEFAULT_FROM_EMAIL=MindBridge Support <support@mindbridge.africa>
